<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="ahbmaster001" name="AHB Master (DMA) Wrapper FSM">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="idle" value="IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="req" value="REQ&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F7A54&quot;&gt;HBUSREQx=1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F0;strokeColor=#2E9E6C;fontColor=#1F7A54;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nonseq" value="NONSEQ&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F7A54&quot;&gt;HBURST=INCRx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F0;strokeColor=#2E9E6C;fontColor=#1F7A54;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="seq" value="SEQ&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F7A54&quot;&gt;burst 傳輸中（含 BUSY 插拍）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F0;strokeColor=#2E9E6C;fontColor=#1F7A54;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="err1" value="ERR1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEEE8;strokeColor=#C0552E;fontColor=#9C4423;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="err2" value="ERR2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEEE8;strokeColor=#C0552E;fontColor=#9C4423;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="260" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="① 觸發 RX 門檻／TX 需補資料" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="idle" target="req">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② 仍在仲裁（HGRANTx=0）" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="req">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="40" />
              <mxPoint x="350" y="40" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="③ 取得匯流排（HGRANTx=1&amp;HREADY）" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="req" target="nonseq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="④ 第一拍被接受" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="nonseq" target="seq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="⑤ 還有剩餘拍數" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="seq">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="40" />
              <mxPoint x="820" y="40" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="⑥ 最後一拍完成，釋放 HBUSREQx&#10;設定完成／IRQ 狀態位元" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="seq" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="⑦ HRESP=ERROR，中止 burst" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="seq" target="err1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="⑧ 第 2 個 error cycle" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="err1" target="err2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="⑨ 設定錯誤狀態位元，釋放 HBUSREQx" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" edge="1" parent="1" source="err2" target="idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
