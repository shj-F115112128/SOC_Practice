        </mxCell>
        <mxCell id="err2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCEEE8;strokeColor=#C0552E;fontColor=#9C4423;fontSize=14;fontStyle=1;" value="ERR2" vertex="1">
          <mxGeometry height="116" width="116" x="472" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="idle" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=1;exitY=0;exitDx=0;exitDy=0;" target="req" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;① 觸發 RX 門檻／TX 需補資料&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="req" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="req" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;② 仍在仲裁（HGRANTx=0）&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="83.6" />
              <mxPoint x="333" y="83.6" />
