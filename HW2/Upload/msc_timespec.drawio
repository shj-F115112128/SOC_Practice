        <mxCell id="labelB" parent="1" style="text;html=1;fontStyle=1;fontSize=13;align=left;" value="B 第一次按下 S4，切到 BREATH (t=t1)" vertex="1">
          <mxGeometry height="40" width="320" y="305" as="geometry" />
        </mxCell>
        <mxCell id="b1" edge="1" parent="1" style="html=1;endArrow=block;strokeColor=#666666;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" value="③ falling-edge　t=t1（使用者按下）">
