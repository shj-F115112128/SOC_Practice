          <mxGeometry height="119.2" width="119.2" x="595" y="122" as="geometry" />
        </mxCell>
        <mxCell id="seq" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F8F0;strokeColor=#2E9E6C;fontColor=#1F7A54;fontSize=14;fontStyle=1;aspect=fixed;" value="SEQ&#xa;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F7A54&quot;&gt;burst 傳輸中（含 BUSY 插拍）&lt;/font&gt;" vertex="1">
          <mxGeometry height="169" width="169" x="881" y="97.1" as="geometry" />
        </mxCell>
        <mxCell id="err1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCEEE8;strokeColor=#C0552E;fontColor=#9C4423;fontSize=14;fontStyle=1;" value="ERR1" vertex="1">
