<mxfile host="Electron">
  <diagram id="ahbmaster001" name="AHB Master (DMA) Wrapper FSM">
    <mxGraphModel dx="1026" dy="608" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0">
      <root>
