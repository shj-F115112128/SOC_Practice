          </mxGeometry>
        </mxCell>
        <mxCell id="labelC" parent="1" style="text;html=1;fontStyle=1;fontSize=13;align=left;" value="C 穩態呼吸迴圈 (t1 之後持續)" vertex="1">
          <mxGeometry height="40" width="320" y="475" as="geometry" />
        </mxCell>
        <mxCell id="c1" edge="1" parent="1" style="html=1;endArrow=block;strokeColor=#666666;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" value="⑤ 每 100us 一次：WritePin(LED0, cmp)　tick #1~#200">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="510" as="sourcePoint" />
            <mxPoint x="1220" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="noteC" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" value="⑤ 是 200 次訊息的代表性畫法，不是只送一次：TTC0 每 100us 觸發一次，依 pwm_counter(0~99)與目前 brightness 比較輸出 LED0；每 100 個 tick(=10ms)算完一輪 PWM、breath_step 前進一步(0→99 漸亮、99→0 漸暗)，200 步 × 10ms = 2000ms，剛好等於題目要求的呼吸週期 T=2s，之後持續循環直到下一次 S4 切模式。" vertex="1">
          <mxGeometry height="55" width="1320" x="40" y="535" as="geometry" />
        </mxCell>
        <mxCell id="divD" edge="1" parent="1" style="html=1;endArrow=none;strokeColor=#dddddd;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="630" as="sourcePoint" />
            <mxPoint x="1360" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelD" parent="1" style="text;html=1;fontStyle=1;fontSize=13;align=left;" value="D 第二次按下 S4，切回 FIXED (t=t2)" vertex="1">
          <mxGeometry height="40" width="320" y="635" as="geometry" />
        </mxCell>
        <mxCell id="d1" edge="1" parent="1" style="html=1;endArrow=block;strokeColor=#666666;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" value="⑥ falling-edge　t=t2（使用者再按一次）">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="665" as="sourcePoint" />
            <mxPoint x="660" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d2" edge="1" parent="1" style="html=1;endArrow=block;strokeColor=#666666;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;rounded=0;curved=0;" value="⑦ 防彈跳判斷 Δt≥200ms→通過 toggle g_Mode: BREATH→FIXED IntrClearPin()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="690" />
              <mxPoint x="750" y="730" />
            </Array>
            <mxPoint x="660" y="690" as="sourcePoint" />
            <mxPoint x="660" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d3" edge="1" parent="1" style="html=1;endArrow=block;strokeColor=#666666;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" value="⑧ 下一個 tick 起：WritePin(LED0,1)　t≈t2+≤100us　LED0恆亮">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="770" as="sourcePoint" />
            <mxPoint x="1220" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="noteFoot" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" value="時間基準：TTC0 tick = 100us（10kHz）；防彈跳視窗 = 200ms；呼吸週期 = 200 tick × 10ms/PWM週期 = 2000ms = T=2s（對應待辦清單中仍待硬體核對的 GPIO=SPI52／TTC0=SPI42 若實際不同，週期本身不受影響）。S4→S4IntrHandler 的中斷延遲（falling-edge 到 ISR 開始執行）為 ARM GIC 典型量級示意，不是實測值，待 Vivado bitstream/SDK 實機跑出來後用 SCUTIMER 或邏輯分析儀量測取代。" vertex="1">
          <mxGeometry height="70" width="1320" x="40" y="820" as="geometry" />
        </mxCell>
