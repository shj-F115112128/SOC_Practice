            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="seq" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;innerLoopWaypoints=1;" target="seq" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;⑤ 還有剩餘拍數&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.2295" y="-6" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="965.5" y="40.3" />
