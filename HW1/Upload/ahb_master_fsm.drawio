        <mxCell id="e8" edge="1" parent="1" source="err1" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" target="err2" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;⑧ 第 2 個 error cycle&lt;/font&gt;">
