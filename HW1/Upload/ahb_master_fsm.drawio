        <mxCell id="req" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F8F0;strokeColor=#2E9E6C;fontColor=#1F7A54;fontSize=14;fontStyle=1;" value="REQ&#xa;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F7A54&quot;&gt;HBUSREQx=1&lt;/font&gt;" vertex="1">
          <mxGeometry height="116" width="116" x="246" y="123.6" as="geometry" />
