        <mxCell id="e7" edge="1" parent="1" source="seq" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="err1" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;⑦ HRESP=ERROR，中止 burst&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
