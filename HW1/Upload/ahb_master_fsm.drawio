        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="req" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;" target="nonseq" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;③ 取得匯流排&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;（HGRANTx=1&amp;amp;HREADY）&lt;/font&gt;&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="nonseq" style="curved=1;endArrow=block;html=1;strokeColor=#999999;fontSize=11;fontColor=#555555;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="seq" value="&lt;font style=&quot;font-size: 12px; color: light-dark(rgb(0, 0, 0), rgb(102, 102, 102));&quot;&gt;④ 第一拍被接受&lt;/font&gt;">
